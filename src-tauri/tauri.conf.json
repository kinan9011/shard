{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shard",
  "mainBinaryName": "Shard",
  "version": "../package.json",
  "identifier": "io.github.kinan9011.shard",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:8080",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Shard",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "backgroundColor": "#191919",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "appimage", "deb", "rpm"],
    "createUpdaterArtifacts": false,
    "publisher": "kinan9011",
    "copyright": "Copyright (c) Ahmed Shamim and kinan9011",
    "license": "MIT",
    "category": "DeveloperTool",
    "shortDescription": "Offline-first developer utilities",
    "longDescription": "Shard is a collection of offline-first developer utilities for macOS, Windows, and Linux.",
    "homepage": "https://github.com/kinan9011/shard",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "files": {
        "Resources/en.lproj/InfoPlist.strings": "macos/en.lproj/InfoPlist.strings"
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "section": "devel",
        "desktopTemplate": "linux/shard.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/shard.desktop"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["shard"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZDNUIwMjJENjM3MUMwOTEKUldTUndIRmpMUUpiYk9HTjVUNC9BdEg1TnFERmF2T3BjWURPUS9ialNxZHFKRVNacjA5OWU2SUoK",
      "endpoints": [
        "https://github.com/kinan9011/shard/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
